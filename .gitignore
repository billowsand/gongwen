# Rust / Cargo
/target/
# vendor/mdx 不是 workspace 成员，在它目录里跑 cargo 会另起一个 target/
/vendor/mdx/target/
*.rs.bk

# Generated application output
/dist/
/output/
/.tmp/
/tmp/
*.aux
*.log
*.synctex.gz
*.synctex.gz(busy)
*.d
*.pdb

# Local runtime assets: downloaded or supplied by the package distributor.
# Older runtime archives still carry Tectonic / a TeX bundle; they are unused.
/runtime/tectonic/
/runtime/texbundle/
/runtime/fonts/*.ttf
/runtime/fonts/*.otf
# 应用内输入法的数据文件（dict.qj / lm.qj）：本地开发副本，随包时进 runtime 压缩包
/runtime/ime/

# Local development copies of document fonts
/font/*

# Local user configuration
/config.json
.env
.env.*

# Editors and IDEs
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# Tool-local state
.claude/*
!.claude/skills/
!.claude/skills/**
.codex-tmp/
.reasonix
reasonix.toml

# code-review-graph: 本地图数据库（MCP 配置 .mcp.json / opencode.jsonc 入库共享）
.code-review-graph/

# archify 生成的架构报告（本地工具产物，不入库）
.archify/

# Python 字节码缓存
__pycache__/

# pi 本地配置与包安装目录：整个 .pi/ 不入库（含 settings.json、依赖，启动时自动安装）
.pi/
# 第三方输入法码表（小鹤音形等）：权利归方案作者、只限私人使用，只能由使用者导入本机，不入库
/assets/fuma/*.txt
!/assets/fuma/xiaohe.txt
model_api_test.md.txt
paper-template/
