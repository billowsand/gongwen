# Rust / Cargo
/target/
*.rs.bk

# Generated application output
/dist/
/output/
/.tmp/
*.aux
*.log
*.synctex.gz
*.synctex.gz(busy)
*.d
*.pdb

# Local runtime binaries: downloaded or supplied by the package distributor
/runtime/tectonic/win-x64/
/runtime/tectonic/linux-arm64/
/runtime/texbundle/*.ttb
/runtime/fonts/*.ttf

# UI fonts are downloaded from GitHub releases by build.rs; licenses stay tracked
/font/*
!/font/licenses/

# Local user configuration
/config.json
.env
.env.*

# Editors and IDEs
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# Tool-local state
.claude/
.codex-tmp/
.reasonix
reasonix.toml
