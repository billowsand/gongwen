# Rust / Cargo
/target/
# vendor/mdx 不是 workspace 成员，在它目录里跑 cargo 会另起一个 target/
/vendor/mdx/target/
*.rs.bk

# Generated application output
/dist/
/output/
/.tmp/
/tmp/
*.aux
*.log
*.synctex.gz
*.synctex.gz(busy)
*.d
*.pdb

# Local runtime binaries: downloaded or supplied by the package distributor
/runtime/tectonic/win-x64/
/runtime/tectonic/linux-arm64/
/runtime/tectonic/linux-amd64/
/runtime/tectonic/darwin-arm64/
# Flattened tectonic binary used by the dev build's runtime lookup
/runtime/tectonic/tectonic
/runtime/texbundle/*.ttb
/runtime/fonts/*.ttf
/runtime/fonts/*.otf
# 应用内输入法的数据文件（dict.qj / lm.qj）：本地开发副本，随包时进 runtime 压缩包
/runtime/ime/

# Local development copies of document fonts
/font/*

# Local user configuration
/config.json
.env
.env.*

# Editors and IDEs
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# Tool-local state
.claude/*
!.claude/skills/
!.claude/skills/**
.codex-tmp/
.reasonix
reasonix.toml
# pi 扩展与包安装目录：.pi/settings.json 入库共享，依赖本身不入库（启动时自动安装）
.pi/npm/
.pi/git/
