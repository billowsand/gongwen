# Rust / Cargo
/target/
*.rs.bk

# Generated application output
/dist/
/output/
/.tmp/
*.aux
*.log
*.synctex.gz
*.synctex.gz(busy)
*.d
*.pdb

# Local runtime binaries: downloaded or supplied by the package distributor
/runtime/tectonic/win-x64/
/runtime/tectonic/linux-arm64/
/runtime/tectonic/darwin-arm64/
# Flattened tectonic binary used by the dev build's runtime lookup
/runtime/tectonic/tectonic
/runtime/texbundle/*.ttb
/runtime/fonts/*.ttf

# Local development copies of document fonts
/font/*

# Local user configuration
/config.json
.env
.env.*

# Editors and IDEs
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# Tool-local state
.claude/*
!.claude/skills/
!.claude/skills/**
.codex-tmp/
.reasonix
reasonix.toml
