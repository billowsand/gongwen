<?xml version="1.0" encoding="UTF-8"?>
<!-- 公文助手稿件包（.gwx）的 MIME 类型。装到 /usr/share/mime/packages/，
     由 shared-mime-info 的 dpkg 触发器自动跑 update-mime-database。
     新包为加密 7z，旧包为 ZIP；以通用二进制文件为父类，按专用后缀关联应用。 -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-gongwen-package">
    <comment>Gongwen Assistant package</comment>
    <comment xml:lang="zh_CN">公文助手稿件包</comment>
    <sub-class-of type="application/octet-stream"/>
    <glob pattern="*.gwx"/>
    <icon name="application-x-gongwen-package"/>
  </mime-type>
</mime-info>
