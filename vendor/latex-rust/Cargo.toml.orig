[package]
name = "latex-rust"
version = "2.0.1"
edition = "2021"
rust-version = "1.76"
authors = ["Jeffrey S Carr <jscarr1964@gmail.com>"]
license = "MIT OR Apache-2.0"
description = "Pure-Rust LaTeX math renderer. Parse to AST, TeX-faithful layout on exact rationals, emit SVG, PNG, or egui shapes. No JavaScript, no webview, no runtime."
readme = "README.md"
repository = "https://github.com/jscarr64/LaTeX-Rust"
homepage = "https://github.com/jscarr64/LaTeX-Rust"
documentation = "https://docs.rs/latex-rust"
keywords = ["latex", "math", "rendering", "svg", "rust"]
categories = ["rendering", "science", "mathematics"]
include = [
    "src/**",
    "data/**",
    "fonts/**",
    "golds/**",
    "tests/**",
    "benches/layout.rs",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "NOTICE",
    "documents/CAPABILITIES.md",
    "documents/SYMBOLS.md",
]

[lib]
name = "latex_rust"
path = "src/lib.rs"

[features]
default = ["std"]
std = []
# PNG raster backend (`src/render/png`).
png = ["dep:tiny-skia"]
# egui Shape backend (`src/render/egui`).
egui = ["dep:egui"]

[dependencies]
ttf-parser = "0.25"
tiny-skia = { version = "0.11", optional = true }
egui = { version = "0.28", optional = true }

[[bench]]
name = "layout"
harness = false
required-features = []

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
